{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET"
    },
    {
      "Sid": "EscribirLanding",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET/landing/*"
    },
    {
      "Sid": "LeerExports",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET/exports/*"
    }
  ]
}
